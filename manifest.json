{
  "manifest_version": 3,
  "name": "Extension Template",
  "version": "1.0.0",
  "description": "A starter template for browser extensions.",
  "action": {
    "default_title": "Extension Template",
    "default_popup": "popup/index.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options/index.html",
  "content_scripts": [
    {
      "matches": [
        "https://example.com/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "extension-template@example.com",
      "strict_min_version": "109.0"
    }
  }
}
