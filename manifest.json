{
  "manifest_version": 3,
  "name": "ULTRA EXTENSION",
  "version": "1.0.0",
  "description": "A modular browser toolbox with a developer console, page lab and mini-extension hub.",
  "action": { "default_title": "Open ULTRA", "default_popup": "popup/index.html" },
  "background": { "service_worker": "background.js" },
  "options_page": "options/index.html",
  "devtools_page": "devtools/devtools.html",
  "chrome_url_overrides": { "newtab": "newtab/index.html" },
  "permissions": ["storage", "activeTab", "scripting", "contextMenus"],
  "content_scripts": [],
  "browser_specific_settings": { "gecko": { "id": "ultra-extension@example.com", "strict_min_version": "115.0" } }
}
